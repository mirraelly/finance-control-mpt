<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="019-create-token-recuperacao-senha" author="eduardo">

        <createTable tableName="token_recuperacao_senha">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="usuario_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_token_recuperacao_token"/>
            </column>
            <column name="expira_em" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="utilizado" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName        ="token_recuperacao_senha"
                baseColumnNames      ="usuario_id"
                referencedTableName  ="usuario"
                referencedColumnNames="id"
                constraintName       ="fk_token_recuperacao_usuario"/>

    </changeSet>

</databaseChangeLog>
