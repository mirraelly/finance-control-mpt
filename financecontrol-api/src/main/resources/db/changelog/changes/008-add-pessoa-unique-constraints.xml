<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-add-pessoa-unique-constraints" author="eduardo">

        <addUniqueConstraint
                tableName      ="pessoa"
                columnNames    ="tenant_id, rg"
                constraintName ="uk_pessoa_tenant_rg"/>

        <addUniqueConstraint
                tableName      ="pessoa"
                columnNames    ="tenant_id, cnh"
                constraintName ="uk_pessoa_tenant_cnh"/>

        <addUniqueConstraint
                tableName      ="pessoa"
                columnNames    ="tenant_id, inscricao_estadual"
                constraintName ="uk_pessoa_tenant_inscricao_estadual"/>

        <addUniqueConstraint
                tableName      ="pessoa"
                columnNames    ="tenant_id, inscricao_municipal"
                constraintName ="uk_pessoa_tenant_inscricao_municipal"/>

        <addUniqueConstraint
                tableName      ="pessoa"
                columnNames    ="tenant_id, razao_social"
                constraintName ="uk_pessoa_tenant_razao_social"/>

    </changeSet>

</databaseChangeLog>
