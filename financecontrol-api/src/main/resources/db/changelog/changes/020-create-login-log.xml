<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="020-create-login-log" author="eduardo">

        <createTable tableName="login_log">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="usuario_id" type="UUID"/>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sucesso" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="motivo_falha" type="VARCHAR(30)"/>
            <column name="endereco_ip" type="VARCHAR(45)"/>
            <column name="user_agent" type="VARCHAR(512)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName        ="login_log"
                baseColumnNames      ="usuario_id"
                referencedTableName  ="usuario"
                referencedColumnNames="id"
                constraintName       ="fk_login_log_usuario"/>

        <createIndex tableName="login_log" indexName="idx_login_log_created_at">
            <column name="created_at"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
